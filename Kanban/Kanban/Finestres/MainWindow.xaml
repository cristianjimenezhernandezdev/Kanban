<Window x:Class="Kanban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kanban"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="680" Width="1240"
        MinHeight="680" MinWidth="1100">

    <!-- MainWindow: finestra principal del tauler Kanban -->
    <!-- Layout: capcalera a dalt + 4 columnes (Backlog, To Do, Doing, Done) -->

    <Window.Resources>
        <!-- Colors per prioritat (vora i fons de la tasca) -->
        <SolidColorBrush x:Key="PrioritatAlta" Color="#E53935"/>
        <SolidColorBrush x:Key="PrioritatMitja" Color="#1E88E5"/>
        <SolidColorBrush x:Key="PrioritatBaixa" Color="#43A047"/>
        <SolidColorBrush x:Key="PrioritatAltaFons" Color="#FFEBEE"/>
        <SolidColorBrush x:Key="PrioritatMitjaFons" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="PrioritatBaixaFons" Color="#E8F5E9"/>

        <!-- Plantilla visual per cada item (tasca) dins dels ListBox -->
        <DataTemplate x:Key="TascaItemTemplate">
            <Border Padding="6" Margin="2" CornerRadius="4" BorderThickness="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Estil per defecte -->
                        <Setter Property="BorderBrush" Value="#DDE6F2"/>
                        <Setter Property="Background" Value="#FFFFFF"/>

                        <!-- Triggers: canvien color segons Prioritat (1 alta, 2 mitja, 3 baixa) -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Prioritat}">
                                <DataTrigger.Value>
                                    <sys:Int32>1</sys:Int32>
                                </DataTrigger.Value>
                                <Setter Property="BorderBrush" Value="{StaticResource PrioritatAlta}"/>
                                <Setter Property="Background" Value="{StaticResource PrioritatAltaFons}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Prioritat}">
                                <DataTrigger.Value>
                                    <sys:Int32>2</sys:Int32>
                                </DataTrigger.Value>
                                <Setter Property="BorderBrush" Value="{StaticResource PrioritatMitja}"/>
                                <Setter Property="Background" Value="{StaticResource PrioritatMitjaFons}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Prioritat}">
                                <DataTrigger.Value>
                                    <sys:Int32>3</sys:Int32>
                                </DataTrigger.Value>
                                <Setter Property="BorderBrush" Value="{StaticResource PrioritatBaixa}"/>
                                <Setter Property="Background" Value="{StaticResource PrioritatBaixaFons}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!-- Contingut de la tasca -->
                <StackPanel>
                    <!-- Descripcio principal -->
                    <TextBlock Text="{Binding Descripcio}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                    <!-- Responsable + data venciment -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Responsable}"
                                   FontSize="12"
                                   Foreground="#666"/>
                        <TextBlock Text=" - "
                                   FontSize="12"
                                   Foreground="#666"/>
                        <TextBlock Text="{Binding DataVenciment, StringFormat=d}"
                                   FontSize="12"
                                   Foreground="#999"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">

        <!-- Files principals: capcalera + area de columnes -->
        <Grid.RowDefinitions>
            <RowDefinition Height="135"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Columnes principals (4) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Capcalera: titol sprint, data, sprint master, participants i botons de projecte -->
        <Border Grid.Row="0" Grid.ColumnSpan="4"
                CornerRadius="10"
                Background="#E8F4FF"
                Padding="10"
                Margin="0 0 0 10"
                BorderBrush="#C9E2FF"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Columna 0: titol + data + sprint master -->
                    <ColumnDefinition Width="2.1*"/>
                    <!-- Columna 1: participants + botons -->
                    <ColumnDefinition Width="3.2*"/>
                    <!-- Columna 2: botons de projecte -->
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Bloc esquerra: nom sprint, data, sprint master -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock x:Name="txtSprintName"
                               Margin="10,0,10,0"
                               Text="Nom Sprint"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2F80ED"/>
                    <TextBlock x:Name="txtSprintData"
                               Margin="10,0,10,6"
                               Text=""
                               FontSize="12"
                               Foreground="#888"/>

                    <!-- Sprint master: etiqueta + combo + label amb el nom actual -->
                    <Grid Margin="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Sprint Master"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#555"
                                   Margin="0,0,10,0"/>

                        <ComboBox x:Name="cmbSprintMaster"
                                  Grid.Column="1"
                                  Height="26"
                                  FontSize="14"
                                  Foreground="#2F80ED"
                                  SelectionChanged="cmbSprintMaster_SelectionChanged"/>

                        <Label x:Name="lblSprintMasterActual"
                               Grid.Column="2"
                               Content=""
                               FontSize="14"
                               Foreground="#2F80ED"
                               VerticalAlignment="Center"
                               Padding="0"
                               Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Bloc central: gestio de participants -->
                <StackPanel Grid.Column="1" Margin="10 0 0 0">

                    <!-- Primera linea: titol participants + combo + botons -->
                    <WrapPanel VerticalAlignment="Top" Margin="0,0,0,4">
                        <TextBlock Text="Participants  "
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <ComboBox x:Name="cmbParticipants"
                                  Width="240"
                                  Height="26"
                                  FontSize="14"
                                  Foreground="#2F80ED"
                                  SelectionChanged="cmbParticipants_SelectionChanged"
                                  Margin="0,0,6,0"/>

                        <Button Content="+"
                                Width="25" Height="25"
                                Margin="0 0 6 0"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderBrush="#2E7D32"
                                ToolTip="Afegir participant al projecte"
                                Click="BtnAddParticipant_Click"/>

                        <Button Content="✕"
                                Width="25" Height="25"
                                Margin="0 0 6 0"
                                Background="#FF9800"
                                Foreground="White"
                                BorderBrush="#F57C00"
                                ToolTip="Desvincular participant del projecte"
                                Click="BtnDesvincularParticipant_Click"/>

                        <Button Content="-"
                                Width="25" Height="25"
                                Margin="0 0 12 0"
                                Background="#F44336"
                                Foreground="White"
                                BorderBrush="#D32F2F"
                                ToolTip="Esborrar usuari de la base de dades"
                                Click="BtnEliminarUsuari_Click"/>

                        <Button Content="Afegir Tasca"
                                Width="130" Height="25"
                                Margin="0 0 0 0"
                                Background="#3498db"
                                Foreground="White"
                                BorderBrush="#2C6A99"
                                ToolTip="Afegir tasca al Backlog"
                                Click="btnAddBacklog_Click"/>
                    </WrapPanel>

                    <!-- Panell on es mostren les etiquetes dels participants del projecte -->
                    <WrapPanel x:Name="panelParticipants"
                               Margin="0 4 0 0"/>
                </StackPanel>

                <!-- Bloc dreta: botons de gestio de projecte -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnCrearProjecte" Style="{StaticResource BotoBase}"
                            Content="Crear Sprint"
                            Width="90" Background="LightGray" Foreground="Black"
                            Height="26" BorderBrush="SkyBlue"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,6"
                            Click="btnCrearProjecte_Click"/>

                    <Button x:Name="btnInfo" Style="{StaticResource BotoBase}"
                            Content="Info" Background="SkyBlue" Foreground="Black"
                            Width="90"
                            Height="26"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,6"
                            Click="btnInfo_Click"/>

                    <Button x:Name="btnObrirProjecte" Style="{StaticResource BotoBase}"
                            Content="Obrir Sprint"
                            Width="90" BorderBrush="SkyBlue"
                            Height="26" Background="LightGray" Foreground="Black"
                            HorizontalAlignment="Right"
                            Click="btnObrirProjecte_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Columna 1: Backlog -->
        <GroupBox Header="Backlog"
                    Grid.Row="1" Grid.Column="0" Margin="5">
            <ListBox x:Name="listBacklog" Margin="5"
                        AllowDrop="True"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Drop="ListBox_Drop"
                        DragOver="ListBox_DragOver"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource TascaItemTemplate}"/>
        </GroupBox>

        <!-- Columna 2: To Do -->
        <GroupBox Header="To Do"
                    Grid.Row="1" Grid.Column="1" Margin="5">
            <ListBox x:Name="listTodo" Margin="5"
                        AllowDrop="True"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Drop="ListBox_Drop"
                        DragOver="ListBox_DragOver"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource TascaItemTemplate}"/>
        </GroupBox>

        <!-- Columna 3: Doing -->
        <GroupBox Header="Doing"
                    Grid.Row="1" Grid.Column="2" Margin="5">
            <ListBox x:Name="listDoing" Margin="5"
                        AllowDrop="True"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Drop="ListBox_Drop"
                        DragOver="ListBox_DragOver"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource TascaItemTemplate}"/>
        </GroupBox>

        <!-- Columna 4: Done -->
        <GroupBox Header="Done"
                    Grid.Row="1" Grid.Column="3" Margin="5">
            <ListBox x:Name="listDone" Margin="5"
                        AllowDrop="True"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Drop="ListBox_Drop"
                        DragOver="ListBox_DragOver"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource TascaItemTemplate}"/>
        </GroupBox>

    </Grid>
</Window>
