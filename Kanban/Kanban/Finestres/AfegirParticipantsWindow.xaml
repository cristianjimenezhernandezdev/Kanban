<Window x:Class="Kanban.AfegirParticipantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kanban"
        mc:Ignorable="d"
        Title="Afegir Participant" Height="250" Width="350">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nom:"/>
        <TextBox x:Name="txtNom" Grid.Row="0" Margin="0 20 0 10"/>

        <TextBlock Text="Cognom:" Grid.Row="1"/>
        <TextBox x:Name="txtCognom" Grid.Row="1" Margin="0 20 0 10"/>

        <Button Grid.Row="2" Style="{StaticResource BotoBase}"
                Content="Afegir" Background="LightGray" Foreground="Black"
                Width="120" Height="35"
                HorizontalAlignment="Center"
                Margin="0 20 0 0"
                Click="btnAfegir_Click"/>
    </Grid>
</Window>