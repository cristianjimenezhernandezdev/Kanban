<Window x:Class="Kanban.ObrirProjecte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kanban"
        mc:Ignorable="d"
        Title="Obrir Projecte" Height="250" Width="350">

    <!-- ObrirProjecte: finestra per seleccionar un projecte existent del grup -->
    <!-- Mostra un ComboBox amb projectes i un boto per confirmar la seleccio -->

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Etiqueta -->
        <TextBlock Text="Seleccionar Projecte"
            Grid.Row="2" Margin="0,18,0,21"/>

        <!-- Llista de projectes (s omple desde codi) -->
        <ComboBox x:Name="cmbSeleccionarProjectes"
             Grid.Row="2"
             Margin="0,60,0,-27"/>

        <!-- Boto seleccionar (va a BtnSeleccionar_Click) -->
        <Button Grid.Row="2"
         Content="Seleccionar"
         Height="35" Style="{StaticResource BotoBase}"
         Width="100" Background="LightGray" Foreground="Black"
         HorizontalAlignment="Center"
         Margin="0,117,0,-97"
         Click="BtnSeleccionar_Click"/>
    </Grid>
</Window>
