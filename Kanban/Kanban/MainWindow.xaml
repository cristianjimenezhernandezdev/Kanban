<Window x:Class="Kanban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kanban"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">

    <Window.Resources>
        <SolidColorBrush x:Key="PrioritatAlta" Color="#E53935"/>
        <SolidColorBrush x:Key="PrioritatMitja" Color="#1E88E5"/>
        <SolidColorBrush x:Key="PrioritatBaixa" Color="#43A047"/>
        <SolidColorBrush x:Key="PrioritatAltaFons" Color="#FFEBEE"/>
        <SolidColorBrush x:Key="PrioritatMitjaFons" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="PrioritatBaixaFons" Color="#E8F5E9"/>

        <DataTemplate x:Key="TascaItemTemplate">
            <Border Padding="6" Margin="2" CornerRadius="4" BorderThickness="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#DDE6F2"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Prioritat}">
                                <DataTrigger.Value>
                                    <sys:Int32>1</sys:Int32>
                                </DataTrigger.Value>
                                <Setter Property="BorderBrush" Value="{StaticResource PrioritatAlta}"/>
                                <Setter Property="Background" Value="{StaticResource PrioritatAltaFons}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Prioritat}">
                                <DataTrigger.Value>
                                    <sys:Int32>2</sys:Int32>
                                </DataTrigger.Value>
                                <Setter Property="BorderBrush" Value="{StaticResource PrioritatMitja}"/>
                                <Setter Property="Background" Value="{StaticResource PrioritatMitjaFons}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Prioritat}">
                                <DataTrigger.Value>
                                    <sys:Int32>3</sys:Int32>
                                </DataTrigger.Value>
                                <Setter Property="BorderBrush" Value="{StaticResource PrioritatBaixa}"/>
                                <Setter Property="Background" Value="{StaticResource PrioritatBaixaFons}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Descripcio}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Responsable}"
                               FontSize="12"
                               Foreground="#666"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">

        <!-- FILES PRINCIPALS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <!-- CAPÇALERA -->
            <RowDefinition Height="*"/>
            <!-- COLUMNES -->
        </Grid.RowDefinitions>

        <!-- COLUMNES PRINCIPALS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- 🔷 CAPÇALERA -->
        <Border Grid.Row="0" Grid.ColumnSpan="4"
                CornerRadius="10"
                Background="#E8F4FF"
                Padding="10"
                Margin="0 0 0 10"
                BorderBrush="#C9E2FF"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 🟦 NOM SPRINT + MASTER -->
                <StackPanel Grid.Column="0">
                    <TextBox x:Name="txtSprintName"
                                Margin="10"
                            Text="Nom Sprint"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#2F80ED"
                            Background="Transparent"
                            BorderThickness="0"
                            IsReadOnly="False"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sprint Master  "
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#555"/>

                        <ComboBox x:Name="cmbSprintMaster"
                                Width="150"
                                FontSize="14"
                                Foreground="#2F80ED"
                                SelectionChanged="cmbSprintMaster_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>


                <!-- 🟡 PARTICIPANTS -->
                <StackPanel Grid.Column="1" Margin="10 0 0 0">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Participants  "
                                    FontSize="16"
                                    FontWeight="SemiBold"/>

                        <ComboBox x:Name="cmbParticipants"
                            Width="150"
                            FontSize="14"
                            Foreground="#2F80ED"
                            SelectionChanged="cmbParticipants_SelectionChanged"/>

                <Button Content="+"
                                Width="25" Height="25"
                                Margin="15 0 0 0"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderBrush="#2E7D32"
                                Click="BtnAddParticipant_Click"/>
                    </StackPanel>

                    <!-- Aquí afegirem visualment els participants -->
                    <WrapPanel x:Name="panelParticipants"
                                Margin="0 5 0 0"/>
                </StackPanel>
                        
                    <!-- 🟣 BOTÓ "CREAR PROJECTE" -->
        <Button x:Name="btnCrearProjecte"
                            Content="Crear Sprint"
                            Width="80"
                            Height="30"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="btnCrearProjecte_Click"/>

                <!-- 🟣 BOTÓ "INFO" -->
                <Button x:Name="btnInfo"
                        Content="Info"
                        Width="80"
                        Height="30" Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="btnInfo_Click"/>

                <Button x:Name="btnObrirProjecte"
                        Content="Obrir Sprint"
                        Width="80"
                        Height="30"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Click="btnObrirProjecte_Click"/>
    </Grid>
        </Border>




        <!-- 🔵 BACKLOG -->
        <GroupBox Header="Backlog"
                    Grid.Row="1" Grid.Column="0" Margin="5">
            <Grid>
                <ListBox x:Name="listBacklog" Margin="5"
                            AllowDrop="True"
                            PreviewMouseMove="ListBox_PreviewMouseMove"
                            Drop="ListBox_Drop"
                            DragOver="ListBox_DragOver"
                            MouseDoubleClick="ListBox_MouseDoubleClick"
                            SelectionMode="Single"
                            ItemTemplate="{StaticResource TascaItemTemplate}"/>

                <!-- Botó circular per afegir tasca -->
                <Button Content="+"
                        Width="40" Height="40"
                        FontSize="24"
                        Background="#3498db"
                        Foreground="White"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Click="btnAddBacklog_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="20"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </GroupBox>



        <!-- 🟠 TODO -->
        <GroupBox Header="To Do"
                    Grid.Row="1" Grid.Column="1" Margin="5">
            <Grid>
                <ListBox x:Name="listTodo" Margin="5"
                            AllowDrop="True"
                            PreviewMouseMove="ListBox_PreviewMouseMove"
                            Drop="ListBox_Drop"
                            DragOver="ListBox_DragOver"
                            MouseDoubleClick="ListBox_MouseDoubleClick"
                            SelectionMode="Single"
                            ItemTemplate="{StaticResource TascaItemTemplate}"/>

                <Button Content="+"
                        Width="40" Height="40"
                        FontSize="24"
                        Background="#2ecc71"
                        Foreground="White"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Click="btnAddTodo_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="20"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                </Button>
            </Grid>
        </GroupBox>



        <!-- 🟣 DOING -->
        <GroupBox Header="Doing"
                    Grid.Row="1" Grid.Column="2" Margin="5">
            <ListBox x:Name="listDoing" Margin="5"
                        AllowDrop="True"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Drop="ListBox_Drop"
                        DragOver="ListBox_DragOver"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource TascaItemTemplate}"/>
        </GroupBox>


        <!-- 🟢 DONE -->
        <GroupBox Header="Done"
                    Grid.Row="1" Grid.Column="3" Margin="5">
            <ListBox x:Name="listDone" Margin="5"
                        AllowDrop="True"
                        PreviewMouseMove="ListBox_PreviewMouseMove"
                        Drop="ListBox_Drop"
                        DragOver="ListBox_DragOver"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource TascaItemTemplate}"/>
        </GroupBox>

    </Grid>
</Window>
