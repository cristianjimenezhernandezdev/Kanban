<Application x:Class="Kanban.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">

    <!-- App.xaml: punt d inici de la aplicacio WPF -->
    <!-- StartupUri indica quina finestra s obre primer (LoginWindow) -->

    <Application.Resources>
        <!-- Recursos globals de la aplicacio (estils, plantilles, colors, etc) -->
        <!-- Aquest Style es el base per als botons amb aspecte "modern" -->

        <Style TargetType="Button" x:Key="BotoBase">

            <!-- Amplada per defecte del boto -->
            <Setter Property="Width" Value="120"/>

            <!-- Alcada per defecte del boto -->
            <Setter Property="Height" Value="40"/>

            <!-- Color del text del boto -->
            <Setter Property="Foreground" Value="White"/>

            <!-- Color del contorn del boto -->
            <Setter Property="BorderBrush" Value="AliceBlue"/>

            <!-- Gruix del contorn del boto -->
            <Setter Property="BorderThickness" Value="2"/>

            <!-- Fons del boto (gradient vertical) -->
            <Setter Property="Background">
                <Setter.Value>
                    <!-- Gradient de dalt a baix -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4CAF50" Offset="0"/>
                        <GradientStop Color="#388E3C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>

            <!-- Template: defineix com es dibuixa el boto -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">

                            <!-- Aqui es pinta el contingut del boto (text, icona, etc) -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style per boto gran (hereta de BotoBase i canvia mida) -->
        <Style TargetType="Button" x:Key="BotoGran"
           BasedOn="{StaticResource BotoBase}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="50"/>
        </Style>

        <!-- Style per boto petit (hereta de BotoBase i canvia mida) -->
        <Style TargetType="Button" x:Key="BotoPetit"
           BasedOn="{StaticResource BotoBase}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
        </Style>

    </Application.Resources>

</Application>



